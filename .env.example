# Токен бота від @BotFather (обов'язково)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF

# Ключ Anthropic для автоматичного визначення калорій/БЖВ (рекомендовано).
# Без нього бот спробує Open Food Facts, а потім запропонує ввести значення вручну.
ANTHROPIC_API_KEY=

# Модель Claude для пошуку поживної цінності
CLAUDE_MODEL=claude-opus-5

# Шлях до бази SQLite
DB_PATH=data/food.db

# Часовий пояс для визначення "сьогодні"
TZ=Europe/Kyiv
